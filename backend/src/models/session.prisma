model Session {
    id        String   @id @default(cuid())
    user      User     @relation(fields: [userId], references: [id])
    userId    String
    token     String   @unique
    expiresAt DateTime @db.Timestamptz(3)
    ipAddress String?
    userAgent String?
    createdAt DateTime @db.Timestamptz(3)
    updatedAt DateTime @db.Timestamptz(3)
}
